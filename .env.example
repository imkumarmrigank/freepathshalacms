# MariaDB. On Hostinger use 127.0.0.1 (not localhost); a local test database can add ?socket=/tmp/mysql.sock
DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# 32+ random chars — signs the session cookie
JWT_SECRET=change-me-to-a-long-random-string

# Prefix used when generating student enrolment numbers -> FP-C04-0001
ENROLLMENT_PREFIX=FP
